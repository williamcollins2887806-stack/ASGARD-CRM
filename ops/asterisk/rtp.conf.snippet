; RTP port range + ICE для ASGARD PBX (include в rtp.conf)
[general]
rtpstart=10000
rtpend=20000
; Убедиться, что фаервол пропускает UDP 10000-20000 на этот хост
;
; ⚠️ МЕДИА WebRTC = ЗВУК В ЗВОНКЕ (инцидент 09.10.2026)
; «Звонок доходит, но ни я ни меня не слышат. Запись разговора есть и там всё слышно.»
;
; Сервер за one-to-one NAT: публичный 92.242.61.184 НЕ на интерфейсе, реальный
; адрес — 192.168.0.135 (ens3). Asterisk биндит RTP на 0.0.0.0, поэтому ICE
; host candidate уходил как 192.168.0.135, и браузер не мог достучаться — при
; этом сигналинг (wss через nginx) и запись (серверный тракт Asterisk↔Mango)
; работают, отсюда «в записи всё слышно, а в трубке нет».
;
; Подменяем РЕАЛЬНЫЙ адрес интерфейса на публичный. include_local_address
; оставляет и локальный кандидат (для клиентов внутри сети).
; Адрес интерфейса смотреть: `ip -4 -o addr show` (при смене хостинга обновить).

[ice_host_candidates]
192.168.0.135 => 92.242.61.184,include_local_address
