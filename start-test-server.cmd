@echo off
REM ═══════════════════════════════════════════════════════════════════════
REM  Тестовый сервер ASGARD CRM для проверки вручную (клон БД).
REM  Порт 3200 — чтобы не мешать другим процессам (3100 — рабочий клон).
REM  БД: asgard_crm_test (копия прода, данные можно портить).
REM  Запуск: двойной клик по этому файлу или `start-test-server.cmd`.
REM ═══════════════════════════════════════════════════════════════════════
setlocal
cd /d "%~dp0"

set DB_NAME=asgard_crm_test
set PORT=3200
set NODE_ENV=development

echo.
echo  ╔════════════════════════════════════════════════════════════════╗
echo  ║  ASGARD CRM — ТЕСТОВЫЙ сервер (клон базы)                      ║
echo  ║                                                                ║
echo  ║   Адрес:      http://127.0.0.1:3200                            ║
echo  ║   Мобильный:  http://127.0.0.1:3200/m/                        ║
echo  ║   БД:         asgard_crm_test (можно ломать)                   ║
echo  ║                                                                ║
echo  ║   Остановить: закрой это окно или Ctrl+C                       ║
echo  ╚════════════════════════════════════════════════════════════════╝
echo.

node src/index.js
