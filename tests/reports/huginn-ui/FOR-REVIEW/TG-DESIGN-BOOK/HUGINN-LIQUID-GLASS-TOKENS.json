    },
    "viewport_ref": { "w_pt": 414, "h_pt": 896, "scale": 2 }
  },
  "crm_color_map": {
    "screen": "var(--bg2)",
    "elevated_glass_base": "var(--bg3)",
    "text_primary": "var(--t1)",
    "text_secondary": "var(--t2)",
    "text_faint": "var(--t3)",
    "placeholder": "color-mix(in srgb, var(--t1) 60%, transparent)",
    "accent": "var(--blue-l)",
    "rail_only": "var(--gold)",
    "separator": "var(--brd-m)",
    "badge": "var(--hg-tg-badge, #FF3B30)",
    "selection_disc": "color-mix(in srgb, var(--bg3) 92%, var(--t1))",
    "bubble_me": "color-mix(in srgb, var(--blue-l) 72%, var(--bg3))",
    "bubble_them": "color-mix(in srgb, var(--bg3) 92%, transparent)",
    "forbidden": ["#7358FF", "#6948FD", "#894DE9", "#000000 as screen", "TG OLED hex literals", "purple outgoing"]
  },
  "glass_primitive": {
    "class": ".hg-glass",
    "css_concept": {
      "background": "color-mix(in srgb, var(--bg3) var(--hg-glass-fill-pct), transparent)",
      "backdrop_filter": "blur(var(--hg-glass-blur)) saturate(var(--hg-glass-sat))",
      "rim": "inset 0 0 0 1px color-mix(in srgb, var(--t1) var(--hg-glass-rim-pct), transparent)",
      "radius": "var(--hg-glass-radius)"
    },
    "roles": {
      "composer": { "fill_pct": 65, "blur_px": 20, "rim_pct": 11, "radius": "20px|50%", "sat": "180%", "ref": ["S28"] },
      "nav": { "fill_pct": 82, "blur_px": 40, "rim_pct": 12, "radius": "32px", "sat": "180%", "ref": ["S36"] },
      "fab": { "fill_pct": 82, "blur_px": 40, "rim_pct": 12, "radius": "50%", "sat": "180%", "ref": ["S36"] },
      "header": { "fill_pct": 48, "blur_px": 32, "rim_pct": 10, "radius": "22px", "sat": "160%", "ref": ["S04", "S24"] },
      "pin": { "fill_pct": 72, "blur_px": 20, "rim_pct": 8, "radius": "20px", "sat": "160%", "ref": ["S24"] },
      "menu": { "fill_pct": 80, "blur_px": 32, "rim_pct": 10, "radius": "18px", "sat": "180%", "ref": ["S16", "S19"] },
      "card": { "fill_pct": 100, "blur_px": 0, "rim_pct": 0, "radius": "26px", "sat": "100%", "ref": ["S20", "S32"], "note": "solid --bg3" },
      "segment": { "fill_pct": 55, "blur_px": 16, "rim_pct": 10, "radius": "20px", "sat": "160%", "ref": ["S17", "S18", "S23"] },
      "media-chrome": { "fill_pct": 70, "blur_px": 28, "rim_pct": 10, "radius": "16px|50%", "sat": "180%", "ref": ["S18", "S30"] }
    }
  },
  "power_saving": {
    "levels": ["full", "reduced", "off"],
    "storage_f0": "localStorage.hg_power_saving",
    "multipliers": {
      "full": { "blur": 1, "sat": 1, "fill_boost": 0, "motion": 1 },
      "reduced": { "blur": 0.5, "sat": 1.2, "fill_boost": 0.08, "motion": 0.6 },
      "off": { "blur": 0, "sat": 1, "fill_boost": "solid_bg3", "motion": 0 }
    },
    "also_respect": "prefers-reduced-motion"
  },
  "geometry": {
    "--hg-tg-tool-size": { "target": "40px", "current": "36px", "wave": "F2" },
